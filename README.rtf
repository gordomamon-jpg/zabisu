\f0  Despliegue de Zabisu en VPS Hostinger KVM 2                                                                                                                                 \
                                                                                                                                                                              \
  1. Conectarse al VPS\
                                                                                                                                                                              \
  ssh root@187.124.226.123\
                                                                                                                                                                              \
  ---             \
  2. Actualizar el sistema\
\
  apt update && apt upgrade -y\
\
  ---\
  3. Instalar dependencias\
\
  apt install -y apache2 php php-mysql php-mbstring php-xml php-curl unzip mysql-server\
\
  curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer\
\
  ---\
  4. Clonar el repositorio\
\
  cd /var/www/html\
  git clone https://github.com/gordomamon-jpg/zabisu.git\
  cd zabisu\
  composer install --no-dev\
\
  ---\
  5. Configurar MySQL\
\
  mysql_secure_installation\
\
  mysql -u root\
\
  CREATE DATABASE zabisu CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\
  CREATE USER 'zabisu_user'@'localhost' IDENTIFIED BY 'TU_PASSWORD';\
  GRANT ALL PRIVILEGES ON zabisu.* TO 'zabisu_user'@'localhost';\
  FLUSH PRIVILEGES;\
  EXIT;\
\
  ---\
  6. Importar la base de datos\
\
  Desde la Mac (terminal local):\
  /usr/local/mysql/bin/mysqldump -u root -p zabisu > ~/Desktop/zabisu.sql\
  scp ~/Desktop/zabisu.sql root@187.124.226.123:/var/www/html/zabisu/\
\
  En el VPS:\
  mysql -u zabisu_user -p zabisu < zabisu.sql\
\
  ---\
  7. Crear archivos de configuraci\'f3n\
\
  cp config/db.example.php config/db.php\
  cp config/mail.example.php config/mail.php\
  nano config/db.php   # Llenar con usuario/password de MySQL\
  nano config/mail.php # Llenar con correo y App Password de Gmail\
\
  ---\
  8. Configurar Apache\
\
  nano /etc/apache2/sites-available/zabisu.conf\
\
  <VirtualHost *:80>\
      ServerName zabisu.com\
      ServerAlias www.zabisu.com\
      DocumentRoot /var/www/html/zabisu\
\
      <Directory /var/www/html/zabisu>\
          AllowOverride All\
          Require all granted\
      </Directory>\
\
      ErrorLog $\{APACHE_LOG_DIR\}/zabisu_error.log\
      CustomLog $\{APACHE_LOG_DIR\}/zabisu_access.log combined\
  </VirtualHost>\
\
  a2ensite zabisu.conf && a2enmod rewrite && a2dissite 000-default.conf && systemctl restart apache2\
\
  ---\
  9. Permisos de archivos\
\
  chown -R www-data:www-data /var/www/html/zabisu\
  chmod -R 755 /var/www/html/zabisu\
  chmod -R 775 /var/www/html/zabisu/uploads\
\
  ---\
  10. SSL con Let's Encrypt\
\
  apt install -y certbot python3-certbot-apache\
  certbot --apache -d zabisu.com -d www.zabisu.com\
\
  ---\
  11. DNS en Hostinger\
\
  - Registro A 
\f1 \uc0\u8594 
\f0  @ 
\f1 \uc0\u8594 
\f0  187.124.226.123\
  - Registro CNAME 
\f1 \uc0\u8594 
\f0  www 
\f1 \uc0\u8594 
\f0  zabisu.com\
  - Eliminar registros A viejos\
\
  ---\
  12. Activar HTTPS en .htaccess\
\
  Descomentar en /var/www/html/zabisu/.htaccess:\
  RewriteCond %\{HTTPS\} off\
  RewriteRule ^(.*)$ https://%\{HTTP_HOST\}%\{REQUEST_URI\} [L,R=301]\
\
  systemctl reload apache2\
\
  ---\
  13. Reiniciar el VPS\
\
  reboot\
