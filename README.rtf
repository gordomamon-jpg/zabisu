\f0\fs24 \cf0 Restaurar la hora al funcionamiento correcto:\
\
UPDATE menu_dia\
SET\
    publicado_desde = TIMESTAMP(DATE_SUB(fecha, INTERVAL 1 DAY), '19:00:00'),\
    pedido_hasta = TIMESTAMP(fecha, '11:30:00')\
WHERE activo = 1;\
\
Para habilitarlo:\
\
UPDATE menu_dia\
SET\
    publicado_desde = DATE_SUB(NOW(), INTERVAL 1 HOUR),\
    pedido_hasta = DATE_ADD(NOW(), INTERVAL 2 HOUR)\
WHERE activo = 1;\
\
